{
  "name": "dsh-greasyfork",
  "version": "2.0.1",
  "description": "GreasyFork 发布/更新插件：读自己的脚本与版本、发布新脚本、发新版本、改简介、站内搜索、查账号信息；凭证只手写录入，不驱动任何浏览器。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./cli": "./lib/cli.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-greasyfork": "./lib/cli.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts",
    "examples",
    "assets"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none test/all.test.js",
    "test:live": "node --test --test-isolation=none test/live-readonly.test.js",
    "dev:sync": "node scripts/dev-sync.mjs",
    "dev:watch": "node scripts/dev-sync.mjs --watch"
  },
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.2.1-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xkzm123/dsh-greasyfork.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "greasyfork",
    "userscript",
    "tampermonkey"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
